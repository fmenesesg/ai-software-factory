# AI Software Factory — workshop parameters (EXAMPLE ONLY)
# Copy to `.env` for local presenter sessions. Never commit real secrets.
# Bootstrap (M1+) validates MUST fields before any cluster mutate.

# --- OpenShift (MUST) ---
OCP_API_URL=https://api.example.cluster:6443
# Provide ONE of:
OCP_TOKEN=
# KUBECONFIG=/path/to/kubeconfig

# --- OpenShift AI / Granite inference (MUST) ---
OSAI_INFERENCE_URL=https://inference.example.cluster/v1
OSAI_MODEL_ID=ibm/granite-*-instruct
# OSAI_API_KEY=  # MAY — only if the endpoint requires it

# --- GitHub (MUST) ---
GITHUB_TOKEN=
GITHUB_OWNER=fmenesesg
GITHUB_REPO=ai-software-factory

# --- Container registry MVP: ghcr.io (MUST write auth) ---
GHCR_TOKEN=

# --- RHDH visualization (SHOULD) ---
# RHDH_URL=
# RHDH_TOKEN=

# --- GitOps promote target (SHOULD) ---
# GITOPS_REPO_URL=

# --- Workshop isolation ---
NAMESPACE_PREFIX=asf-workshop-
PROFILE=standard
# PROFILE=minimal|standard|full

# --- Safety ---
DRY_RUN=true
# INFERENCE_FALLBACK=false  # emergency recorded/local only — never primary narrative
