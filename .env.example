# AI Software Factory — workshop parameters (EXAMPLE ONLY)
# Copy to `.env` for local presenter sessions. Never commit `.env`.
# Bootstrap (M1+) validates MUST fields before any cluster mutate.

# --- OpenShift (MUST for PROFILE=standard|full) ---
OCP_API_URL=https://api.example.cluster:6443
# Provide ONE of:
OCP_TOKEN=
# KUBECONFIG=/path/to/kubeconfig

# --- Inference (OpenAI-compatible) ---
# OCP workshop: OpenShift AI / Granite URL
# Kind OSS (PROFILE=kind-oss): host Ollama, e.g. http://host.containers.internal:11434/v1
OSAI_INFERENCE_URL=https://inference.example.cluster/v1
OSAI_MODEL_ID=ibm/granite-*-instruct
# Kind example: OSAI_MODEL_ID=granite3.1-moe:1b
# OSAI_API_KEY=  # MAY — only if the endpoint requires it
GATEWAY_STUB_MODE=false
# INFERENCE_FALLBACK=false  # emergency recorded/local only — never primary narrative

# --- GitHub (MUST) — scoped least-privilege; never commit real tokens ---
GITHUB_TOKEN=
GITHUB_OWNER=fmenesesg
GITHUB_REPO=ai-software-factory
# GIT_ALLOWED_REMOTE=https://github.com/fmenesesg/ai-software-factory.git

# --- Container registry MVP: ghcr.io (MUST write auth) ---
GHCR_TOKEN=

# --- RHDH visualization (SHOULD) ---
# RHDH_URL=
# RHDH_TOKEN=

# --- GitOps promote target (SHOULD) ---
# GITOPS_REPO_URL=

# --- Orchestrator checkpoint (SHOULD; PostgreSQL, same host family as pgvector later) ---
# CHECKPOINT_DSN=postgresql://asf:asf@127.0.0.1:5432/asf_checkpoints

# --- Local service URLs (dev defaults) ---
INFERENCE_GATEWAY_URL=http://127.0.0.1:8081
ORCHESTRATOR_URL=http://127.0.0.1:8080
MCP_GITHUB_URL=http://127.0.0.1:8091
MCP_FILESYSTEM_URL=http://127.0.0.1:8092
MCP_GIT_URL=http://127.0.0.1:8093
MCP_OPENSHIFT_URL=http://127.0.0.1:8094
MCP_KUBERNETES_URL=http://127.0.0.1:8095
WORKSPACE_ROOT=.

# --- Workshop isolation ---
NAMESPACE_PREFIX=asf-workshop-
PROFILE=standard
# PROFILE=minimal|standard|full|kind-oss
# Kind OSS: ASF_KIND_CLUSTER=asf-kind
# Kind OSS: KIND_EXPERIMENTAL_PROVIDER=podman

# --- Safety ---
DRY_RUN=true
